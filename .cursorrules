{
  "rules": {
    "typescript": {
      "strict": true,
      "noImplicitAny": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "forceConsistentCasingInFileNames": true
    },
    "react": {
      "useHooks": true,
      "preferFunctionComponents": true,
      "noPropTypes": true,
      "jsxSingleQuote": false
    },
    "imports": {
      "order": [
        "^react",
        "^@/components/ui/(.*)$",
        "^@/lib/(.*)$",
        "^@/services/(.*)$",
        "^@/models/(.*)$",
        "^@/components/(.*)$",
        "^@/pages/(.*)$",
        "^[./]"
      ],
      "newlinesBetweenGroups": 1
    },
    "naming": {
      "components": "^[A-Z][a-zA-Z0-9]*$",
      "hooks": "^use[A-Z][a-zA-Z0-9]*$",
      "services": "^[a-z][a-zA-Z0-9]*Service$",
      "types": "^[A-Z][a-zA-Z0-9]*$",
      "interfaces": "^I[A-Z][a-zA-Z0-9]*$"
    },
    "fileStructure": {
      "components": "src/components",
      "pages": "src/pages",
      "services": "src/services",
      "models": "src/models",
      "lib": "src/lib",
      "hooks": "src/hooks",
      "utils": "src/utils",
      "assets": "src/assets",
      "ui": "src/components/ui"
    },
    "styling": {
      "framework": "tailwind",
      "componentLibrary": "shadcn/ui",
      "useTailwindClasses": true,
      "preferShadcnComponents": true,
      "designSystem": {
        "reference": "CONSTITUTION.md",
        "philosophy": "Minimalismus — klare Borders, keine Schatten, kein Glassmorphism, kein backdrop-blur",
        "tokens": "src/lib/designTokens.ts — cardPreset, inputPreset, buttonPreset, badgePreset",
        "colors": {
          "light": "Primary: white, Secondary: black (borders), Tertiary: red-500",
          "dark": "Primary/Secondary vertauscht für Lesbarkeit"
        },
        "typography": "JetBrains Mono (font-mono), responsive text-sm sm:text-base md:text-lg",
        "cards": "bg-card border border-secondary rounded-lg — keine shadow, kein blur",
        "background": "Background-Komponente mit subtilen Theme-Gradients (kein Rainbow-Glass)",
        "skeletonLoading": {
          "mandatory": true,
          "description": "Skeleton statt Spinner für Ladezustände",
          "implementation": "@/components/ui/skeleton",
          "styling": {
            "classes": "bg-muted rounded animate-pulse",
            "shapes": [
              "Text: h-4 w-[width]",
              "Avatar: h-[size] w-[size] rounded-full",
              "Badge: h-6 w-[width] rounded-full",
              "Card: Layout passend zum echten Content"
            ]
          },
          "usage": [
            "3–5 Skeleton-Items bei Listen",
            "Struktur an echten Content anpassen",
            "Skeleton für alle interaktiven Elemente"
          ]
        }
      }
    },
    "testing": {
      "componentTests": "__tests__",
      "testFiles": "*.test.tsx",
      "coverageThreshold": 80,
      "mandatory": "All tests must pass before committing - no exceptions"
    },
    "taskCompletion": {
      "mandatory": true,
      "description": "Vor Abschluss jeder Aufgabe mit Code-Änderungen muss die CI-Validierung grün sein",
      "reference": "CONSTITUTION.md",
      "command": "npm run validate",
      "includes": ["type-check", "lint", "format:check", "test"],
      "rules": [
        "Vor dem Abschluss einer Aufgabe mit Dateiänderungen `npm run validate` ausführen — nicht nur einzelne Schritte",
        "Bei format:check-Fehlern `npm run format` ausführen und validate erneut laufen lassen",
        "Fehler beheben, bevor die Aufgabe als erledigt gemeldet wird; kein Abschluss mit rotem validate",
        "Ergebnis kurz bestätigen (z. B. validate grün, ggf. betroffene Tests)",
        "Entfällt nur bei reinen Lese-, Review- oder Erklär-Aufgaben ohne Dateiänderungen",
        "Bei Änderungen an E2E-Tests oder Playwright-Flows zusätzlich `npm run test:e2e` ausführen (nicht Teil von validate)"
      ],
      "ciParity": ".github/workflows/firebase-deploy-dev.yml — Job validate blockiert Deploy bei Fehlern"
    },
    "ux": {
      "mobileFirst": {
        "mandatory": true,
        "description": "Always design mobile-first with responsive breakpoints",
        "breakpoints": {
          "mobile": "base (320px+)",
          "tablet": "sm: (640px+)",
          "desktop": "md: (768px+)",
          "large": "lg: (1024px+)",
          "xl": "xl: (1280px+)"
        },
        "principles": [
          "Start with mobile layout and scale up",
          "Touch targets minimum 44px",
          "Readable text without zooming",
          "Thumb-friendly navigation",
          "Progressive enhancement for larger screens",
          "Optimize for one-handed use",
          "Consider swipe gestures and touch interactions"
        ],
        "responsiveDesign": {
          "typography": "text-sm sm:text-base md:text-lg lg:text-xl",
          "spacing": "p-4 md:p-6 lg:p-8",
          "layout": "flex-col sm:flex-row",
          "grids": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
        }
      },
      "pageFallbacks": {
        "mandatory": true,
        "description": "Niemals leere oder schwarze Seiten — jeder Page-Zustand braucht einen sichtbaren Fallback",
        "reference": "CONSTITUTION.md — Skeleton Loading, Alert-Komponenten",
        "rules": [
          "Jede Page muss für Lade-, Leer-, Fehler- und ungültige-Daten-Zustände explizit rendern — kein stiller Crash und kein leerer Viewport",
          "Laden: Skeleton passend zum echten Layout (siehe skeletonLoading), kein blanker Screen",
          "Keine Daten: Empty-State mit kurzer Erklärung und nächstem Schritt (z. B. CTA zurück, filtern, anlegen)",
          "Fehler / ungültige Eingaben: Alert oder Issue-Panel mit Ursache und Handlungsempfehlung — nicht nur console.error",
          "Teilweise nutzbare Daten: Editor/Liste für gültige Einträge + sichtbarer Hinweis auf übersprungene/ungültige Einträge",
          "Async-Init (Router-State, Params): isInitialized o. ä. — bis dahin Skeleton, danach Validierung mit Fallback",
          "Fehler in Utils/Hooks abfangen, die UI crashen könnten (z. B. ungültige Datumsstrings) — defensive Validierung statt RangeError"
        ],
        "forbidden": [
          "Leere div ohne Inhalt als Page-Ergebnis",
          "Nur null/undefined return ohne Erklärung für den Nutzer",
          "Unbehandelte Exceptions, die die ganze Route weiß/schwarz lassen"
        ]
      }
    },
    "git": {
      "commitMessageFormat": "^(feat|fix|docs|style|refactor|test|chore)(\\(.+\\))?: .+$",
      "branchNaming": "^(feature|bugfix|hotfix|release)/.+$"
    },
    "api": {
      "requestHandling": {
        "mandatory": true,
        "description": "Prevent duplicate API requests and optimize token usage",
        "rules": [
          "Always add loading guards to prevent multiple simultaneous API requests",
          "Check if loading state is true before making API calls",
          "Disable buttons/inputs during API requests to prevent duplicate calls",
          "Use empty dependency arrays [] in useEffect for one-time data loading (e.g. categories on mount)",
          "Never include service objects (e.g. eventService, eventCategoryService) in useEffect dependencies - they create new instances on each render",
          "For user-triggered actions (button clicks), ensure only ONE request is made per action",
          "Implement request deduplication for parallel requests (e.g. token requests)"
        ],
        "examples": {
          "loadingGuard": "if (loading) return; // Prevent duplicate requests",
          "useEffectDependencies": "useEffect(() => { loadData(); }, []); // Empty array for one-time load",
          "buttonDisabled": "disabled={loading || !isValid} // Disable during request",
          "asyncFunctionGuard": "const performAction = async () => { if (loading) return; setLoading(true); ... }"
        },
        "tokenManagement": {
          "mandatory": true,
          "description": "Optimize Firebase token requests to prevent QUOTA_EXCEEDED errors",
          "rules": [
            "Always use getIdToken() without forceRefresh parameter - Firebase caches tokens automatically",
            "Never use getIdToken(true) unless explicitly refreshing an expired token",
            "Implement token caching in ApiClient to deduplicate parallel token requests",
            "Cache tokens for 50 minutes (Firebase tokens are valid for 1 hour)",
            "Share the same token Promise across parallel API requests"
        ]
      },
      "errorHandling": {
        "mandatory": true,
        "description": "Handle API errors gracefully without causing request loops",
        "rules": [
          "Never retry failed requests automatically in useEffect without user interaction",
          "Use retry callbacks only in error handlers (showUserFriendlyError)",
          "Prevent infinite retry loops by checking loading state before retrying"
        ]
      }
    }
  }
}} 